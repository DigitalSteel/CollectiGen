+@pytest.mark.parametrize('classname,accepted', [
+    ('.tmp.bounded.test_state', True),
+    ('tmp.bounded.test_state', False),
+    ('other.test_state', False),
+    ('prefix..tmp.bounded.test_state', False),
+])
+def test_review_preserves_literal_dot_path_and_full_junit_identity(tmp_path,classname,accepted):
+    review=_review_fixture(tmp_path)
+    relative='.tmp/bounded/test_state.py'
+    target=tmp_path/relative;target.parent.mkdir(parents=True)
+    target.write_bytes((tmp_path/'test_state.py').read_bytes())
+    review['source_pins'].pop('test_state.py')
+    review['source_pins'][relative]=hashlib.sha256(target.read_bytes()).hexdigest()
+    binding=hashlib.sha256(json.dumps({k:review[k] for k in ('source_pins','artifact_pins')},sort_keys=True,separators=(',',':')).encode()).hexdigest()
+    review['acceptance_finding']['reviewed_pins_sha256']=binding
+    reference=relative+'::test_delayed_state'
+    for phase in review['delayed_phases']:
+        for check in DELAYED_CHECKS:phase[check]=reference
+    (tmp_path/'results.xml').write_text('<testsuites><testsuite><testcase classname="'+classname+'" name="test_delayed_state"/></testsuite></testsuites>',encoding='utf-8')
+    execution=json.loads((tmp_path/'execution.json').read_bytes())
+    execution.update(reviewed_pins_sha256=binding,tests=[reference],result_pins={
+        'results.xml':hashlib.sha256((tmp_path/'results.xml').read_bytes()).hexdigest()})
+    (tmp_path/'execution.json').write_text(json.dumps(execution),encoding='utf-8')
+    review['execution_pins']={'execution.json':hashlib.sha256((tmp_path/'execution.json').read_bytes()).hexdigest()}
+    path=tmp_path/'review.json';path.write_text(json.dumps(review),encoding='utf-8')
+    result=audit_review(path,root=tmp_path)
+    assert (result['status']=='accepted') is accepted
+    if not accepted:assert any('lacks a passing pinned result' in e for e in result['errors'])
+
+
